    {
      "name": "07. End-to-End Flow",
      "description": "Run this folder in order with Collection Runner. Creates a customer, loads a product, places an order, then reads order and order-lines.",
      "item": [
        {
          "name": "1. Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const id = pm.response.text().replaceAll('\"', '').trim();",
                  "pm.collectionVariables.set('customerId', id);",
                  "pm.environment.set('customerId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.{{$timestamp}}@example.com\",\n  \"address\": {\n    \"street\": \"Analytical Engine Way\",\n    \"houseNumber\": \"12A\",\n    \"zipCode\": \"10001\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{customerUrl}}/api/v1/customer"
          }
        },
        {
          "name": "2. Find all products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('At least one product exists', () => pm.expect(products.length).to.be.above(0));",
                  "pm.collectionVariables.set('productId', String(products[0].id));",
                  "pm.environment.set('productId', String(products[0].id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productUrl}}/api/v1/products"
          }
        },
        {
          "name": "3. Create order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ref = 'ORD-' + Date.now();",
                  "pm.collectionVariables.set('orderReference', ref);",
                  "pm.environment.set('orderReference', ref);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const id = pm.response.text().trim();",
                  "pm.collectionVariables.set('orderId', id);",
                  "pm.environment.set('orderId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{orderReference}}\",\n  \"totalAmount\": 999.99,\n  \"paymentMethod\": \"PAYPAL\",\n  \"customerId\": \"{{customerId}}\",\n  \"products\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{orderUrl}}/api/v1/orders"
          }
        },
        {
          "name": "4. Find order by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "5. Find order lines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderUrl}}/api/v1/order-lines/order/{{orderId}}"
          }
        }
      ]
    }
  ]
