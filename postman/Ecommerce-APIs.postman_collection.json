                  "  pm.environment.set('productId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"USB-C Hub\",\n  \"description\": \"7-in-1 USB-C docking hub\",\n  \"price\": 59.99,\n  \"availableQuantity\": 40,\n  \"categoryId\": {{categoryId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{productUrl}}/api/v1/products",
            "description": "POST /api/v1/products — returns the new product id. Seeded categories typically start at id 1 (Electronics)."
          }
        },
        {
          "name": "Purchase products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"productId\": {{productId}},\n    \"quantity\": 1\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{productUrl}}/api/v1/products/purchase",
            "description": "POST /api/v1/products/purchase — decreases available quantity. Prefer the order flow so stock is not decremented twice."
          }
        },
        {
          "name": "Find product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Find all products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('Body is an array', () => pm.expect(products).to.be.an('array'));",
                  "if (Array.isArray(products) && products.length > 0) {",
                  "  pm.collectionVariables.set('productId', String(products[0].id));",
                  "  pm.environment.set('productId', String(products[0].id));",
                  "  if (products[0].categoryId) {",
                  "    pm.collectionVariables.set('categoryId', String(products[0].categoryId));",
                  "    pm.environment.set('categoryId', String(products[0].categoryId));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productUrl}}/api/v1/products"
          }
        }
      ]
    },
