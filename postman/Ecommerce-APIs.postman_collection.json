    {
      "name": "02. Customer Service",
      "item": [
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const id = pm.response.text().replaceAll('\"', '').trim();",
                  "if (id) {",
                  "  pm.collectionVariables.set('customerId', id);",
                  "  pm.environment.set('customerId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.lovelace@example.com\",\n  \"address\": {\n    \"street\": \"Analytical Engine Way\",\n    \"houseNumber\": \"12A\",\n    \"zipCode\": \"10001\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{customerUrl}}/api/v1/customer",
            "description": "POST /api/v1/customer — returns the created customer id as a string."
          }
        },
        {
          "name": "Update customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 202', () => pm.response.to.have.status(202));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{customerId}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Byron\",\n  \"email\": \"ada.byron@example.com\",\n  \"address\": {\n    \"street\": \"Analytical Engine Way\",\n    \"houseNumber\": \"12B\",\n    \"zipCode\": \"10001\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{customerUrl}}/api/v1/customer",
            "description": "PUT /api/v1/customer — 202 Accepted."
          }
        },
        {
          "name": "Find all customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customerUrl}}/api/v1/customer"
          }
        },
        {
          "name": "Find customer by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customerUrl}}/api/v1/customer/{{customerId}}",
            "description": "GET /api/v1/customer/{customerId}"
          }
        },
        {
          "name": "Customer exists by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customerUrl}}/api/v1/customer/exist/{{customerId}}",
            "description": "GET /api/v1/customer/exist/{customerId} — returns boolean."
          }
        },
        {
          "name": "Delete customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 202', () => pm.response.to.have.status(202));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{customerUrl}}/api/v1/customer/{{customerId}}",
            "description": "DELETE /api/v1/customer/{customerId} — 202 Accepted. Run this last if you still need the customer for orders."
          }
        }
      ]
    },
    {
      "name": "03. Product Service",
      "item": [
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const id = pm.response.text().trim();",
                  "if (id) {",
