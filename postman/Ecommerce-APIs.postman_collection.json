              "mode": "raw",
              "raw": "{\n  \"amount\": 999.99,\n  \"paymentMethod\": \"PAYPAL\",\n  \"orderId\": {{orderId}},\n  \"orderRefrence\": \"{{orderReference}}\",\n  \"customer\": {\n    \"id\": \"{{customerId}}\",\n    \"firstName\": \"Ada\",\n    \"lastName\": \"Lovelace\",\n    \"email\": \"ada.lovelace@example.com\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{paymentUrl}}/api/v1/payments",
            "description": "POST /api/v1/payments\nField name in the payment service is `orderRefrence` (typo in the record).\nCreating an order already calls this internally; use this to test the payment service directly."
          }
        }
      ]
    },
